<?xml version="1.0" encoding="utf-8"?>
<!-- INTENTIONALLY VULNERABLE TEST FIXTURE -->
<odoo>
    <record id="patient_portal_rule" model="ir.rule">
        <field name="name">Portal sees all patients</field>
        <field name="model_id" ref="model_clinic_patient"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="patient_company_rule" model="ir.rule">
        <field name="name">Patient multi-company (legacy)</field>
        <field name="model_id" ref="model_clinic_patient"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'child_of', [user.company_id.id])]</field>
    </record>
    <record id="group_clinic_user" model="res.groups">
        <field name="name">Clinic User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
